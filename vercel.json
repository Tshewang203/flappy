{
  "version": 2,
  "builds": [
    { "src": "game/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/game/index.html" },
    { "src": "/(.*)", "dest": "/game/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
